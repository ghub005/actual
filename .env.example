# Actual Plus Environment Configuration
# Copy this file to .env and fill in the values

# =============================================================================
# ML SERVICE CONFIGURATION
# =============================================================================

# LLM Provider (claude or openai)
ML_PRIMARY_PROVIDER=claude

# Anthropic (Claude) API Key - Required if using Claude
ANTHROPIC_API_KEY=

# OpenAI API Key - Optional fallback provider
OPENAI_API_KEY=

# Cost Controls
ML_DAILY_TOKEN_LIMIT=50000
ML_BATCH_SIZE=10
ML_CONFIDENCE_THRESHOLD=0.7
ML_MAX_CONCURRENT=3

# ML Service Port
ML_SERVICE_PORT=3050

# Security: API Key (required in production)
ML_SERVICE_API_KEY=

# Security: Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3001

# =============================================================================
# ACTUAL BUDGET SERVER
# =============================================================================

# Server port
ACTUAL_PORT=5006

# Upload limits
ACTUAL_UPLOAD_FILE_SIZE_LIMIT_MB=20
ACTUAL_UPLOAD_SYNC_ENCRYPTED_FILE_SIZE_LIMIT_MB=50
ACTUAL_UPLOAD_FILE_SYNC_SIZE_LIMIT_MB=20

# =============================================================================
# MCP SERVER (Claude Desktop Integration)
# =============================================================================

# Actual server URL (for MCP to connect to)
ACTUAL_SERVER_URL=http://localhost:5006

# Actual server password
ACTUAL_PASSWORD=

# Budget sync ID (find in Actual > Settings > Show advanced settings)
ACTUAL_BUDGET_ID=

# Local data directory for MCP cache
ACTUAL_DATA_DIR=/tmp/actual-mcp

# =============================================================================
# OPTIONAL: BANK SYNC (SimpleFIN)
# =============================================================================

# SimpleFIN access URL (if using automatic bank sync)
# SIMPLEFIN_ACCESS_URL=
